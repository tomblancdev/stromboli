# Stromboli Server - Containerized with Socket Mount
#
# This container connects to the host's Podman via socket mount.
# No Podman installation needed inside - just the CLI for commands.

# Build stage - uses native cross-compilation (no QEMU needed)
FROM --platform=$BUILDPLATFORM golang:1.24-alpine AS builder

# Target platform (set by docker buildx)
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH

# Version info (injected at build time)
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git

# Copy go mod files first for caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build static binary with native cross-compilation (fast!)
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -ldflags="-w -s \
    -X stromboli/internal/version.Version=${VERSION} \
    -X stromboli/internal/version.Commit=${COMMIT} \
    -X stromboli/internal/version.BuildTime=${BUILD_TIME}" \
    -o /stromboli ./cmd/stromboli

# Runtime stage - minimal image
FROM alpine:3.23

# Install podman-remote (lightweight CLI that talks to socket)
RUN apk add --no-cache \
    podman-remote \
    ca-certificates \
    tzdata

# Create symlink so "podman" command works (podman-remote -> podman)
RUN ln -s /usr/bin/podman-remote /usr/bin/podman

# Create non-root user
RUN adduser -D -u 1000 stromboli

# Create directories for runtime data
RUN mkdir -p /app/sessions /app/secrets && \
    chown -R stromboli:stromboli /app

# Copy binary from builder
COPY --from=builder /stromboli /usr/local/bin/stromboli

# Switch to non-root user
USER stromboli
WORKDIR /app

# Default config location
ENV STROMBOLI_AGENT_SECRETS_FILE=/app/secrets/.claude-secrets
ENV STROMBOLI_AGENT_SESSIONS_DIR=/app/sessions

EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

ENTRYPOINT ["stromboli"]
