# Stromboli Server - Go + Podman
FROM golang:1.24

# Install podman
RUN apt-get update && apt-get install -y --no-install-recommends \
    podman \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy go mod files first for caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source
COPY . .

# Build
RUN go build -o /usr/local/bin/stromboli ./cmd/stromboli

EXPOSE 8080

ENTRYPOINT ["stromboli"]
